{
  "name": "@riri/types",
  "version": "0.1.0",
  "description": "TypeScript type definitions for Riri",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["riri", "types", "typescript"],
  "author": "Riri Project",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1"
  }
}

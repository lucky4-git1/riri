{
  "name": "@riri/core",
  "version": "0.1.0",
  "description": "Core pipeline orchestrator and main entry point for the Riri writing intelligence engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["riri", "writing-intelligence", "engine", "paraphrase", "local-first"],
  "author": "Riri Project",
  "license": "MIT",
  "dependencies": {
    "@riri/types": "workspace:*",
    "@riri/parser": "workspace:*",
    "@riri/analyzer": "workspace:*",
    "@riri/decision-engine": "workspace:*",
    "@riri/laya-adapter": "workspace:*",
    "@riri/transformations": "workspace:*",
    "@riri/validator": "workspace:*",
    "@riri/scoring": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8",
    "rimraf": "^6.0.1"
  }
}

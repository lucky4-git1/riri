{
  "name": "@riri/laya-adapter",
  "version": "0.1.0",
  "description": "Laya decision engine adapter for Riri",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["riri", "laya", "decision-engine"],
  "author": "Riri Project",
  "license": "MIT",
  "dependencies": {
    "@riri/types": "workspace:*",
    "@riri/model-runtime": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8",
    "rimraf": "^6.0.1"
  }
}

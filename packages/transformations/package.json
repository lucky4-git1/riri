{
  "name": "@riri/transformations",
  "version": "0.1.0",
  "description": "Text transformation plugins for Riri",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["riri", "transformations", "paraphrasing", "rewriting"],
  "author": "Riri Project",
  "license": "MIT",
  "dependencies": {
    "@riri/types": "workspace:*",
    "@riri/parser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8",
    "rimraf": "^6.0.1"
  }
}
